{
  "name": "creator-space-desktop",
  "version": "1.0.0",
  "description": "Creator Space desktop app",
  "main": "main.js",
  "author": "Creator Space",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.creatorspace.desktop",
    "productName": "Creator Space",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage"], "category": "Office", "icon": "build/icon.png" }
  }
}
